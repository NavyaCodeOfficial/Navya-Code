# Public site URL (used to build canonical URLs, sitemap, and structured data)
VITE_SITE_URL=https://www.navyacode.com

# Optional: Google Analytics measurement ID (leave blank to disable analytics)
VITE_GA_MEASUREMENT_ID=

# Optional: if you add a serverless contact form endpoint (e.g. Formspree, Resend, your own API)
VITE_CONTACT_FORM_ENDPOINT=
